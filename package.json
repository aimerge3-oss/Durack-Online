{
  "name": "durack-online",
  "version": "0.1.0",
  "description": "Классический Дурак онлайн — Telegram Mini App на Cloudflare Workers",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create durack-db",
    "db:migrate": "wrangler d1 execute durack-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute durack-db --local --file=./schema.sql"
  },
  "keywords": ["durak", "telegram", "mini-app", "cloudflare"],
  "author": "aimerge3-oss",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "itty-router": "^5.0.17"
  }
}
